# 公开配置。
#
# 这两个值是「给浏览器用的」，写在代码里、提交进仓库都不怕暴露：
#   · URL 就是项目地址，本来就要写到请求里
#   · anon / publishable key 只代表「匿名身份」，能做什么由数据库的 RLS 策略决定
#     （见 supabase/schema.sql）
#
# 【绝对不要】把 service_role 或 sb_secret_ 开头的 key 放进这个文件。
# 那个 key 能绕过所有 RLS，等于管理员密码，只能待在服务端。
#
# 本地想临时覆盖：新建 .env.local（已在 .gitignore 里），同名变量会覆盖这里的值。

VITE_SUPABASE_URL=https://olbcaxskonobmnisdncu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ZhECVjQXWBGtZA5OJhQ7lg_SbZ7ElmK
